SCALPER_AI_ENV=research
SCALPER_AI_CONFIG_DIR=./configs
SCALPER_AI_LOG_LEVEL=INFO
SCALPER_AI_LOG_JSON=false
SCALPER_AI_RUNTIME_MODE=research
SCALPER_AI_PAPER_TRADING_DEFAULT=true
SCALPER_AI_REDIS_HOST=localhost
SCALPER_AI_REDIS_PORT=6379
SCALPER_AI_REDIS_DB=0
SCALPER_AI_MAX_POSITION_SIZE=100000.0
SCALPER_AI_MAX_DAILY_DRAWDOWN=0.02
SCALPER_AI_KILL_SWITCH_ENABLED=true
SCALPER_AI_DATA_RAW_DIR=data/raw
SCALPER_AI_DATA_PROCESSED_DIR=data/processed
SCALPER_AI_DATA_ARTIFACTS_DIR=data/artifacts
SCALPER_AI_MONITORING_ALERT_WEBHOOK_URL=
SCALPER_AI_MONITORING_ALERT_WEBHOOK_TIMEOUT_SECONDS=5.0
SCALPER_AI_MONITORING_ALERT_INCLUDE_WARNINGS=true
